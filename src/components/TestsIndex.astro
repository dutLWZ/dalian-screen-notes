---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localize, useTranslations, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = useTranslations(locale);
const tests = (await getCollection('tests')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title={t('sections.tests.title')}>
  <h1>{t('sections.tests.title')}</h1>
  <p>{t('sections.tests.desc')}</p>
  {
    tests.length === 0 ? (
      <p class="muted">{t('section.coming')}</p>
    ) : (
      <div class="grid">
        {tests.map((entry) => {
          const title = locale === 'en'
            ? (entry.data.titleEn ?? entry.data.title)
            : entry.data.title;
          return (
            <a class="card" href={localize(locale, `tests/${entry.id}`)}>
              <h3>{title}</h3>
              <p class="muted">{entry.data.date.toISOString().slice(0, 10)}</p>
            </a>
          );
        })}
      </div>
    )
  }
</Base>
