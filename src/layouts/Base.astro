---
import { localize, useTranslations, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = useTranslations(locale);

const navItems = [
  { key: 'nav.home', path: '' },
  { key: 'nav.tests', path: 'tests' },
  { key: 'nav.dcp', path: 'dcp' },
  { key: 'nav.subtitles', path: 'subtitles' },
  { key: 'nav.dalianCinemas', path: 'dalian-cinemas' },
  { key: 'nav.dalianCommunity', path: 'dalian-community' },
  { key: 'nav.shares', path: 'shares' },
  { key: 'nav.about', path: 'about' },
];

const otherLocale = locale === 'zh' ? 'en' : 'zh';
const otherLocaleUrl = localize(otherLocale, '');
const currentPath = Astro.url.pathname;
const faviconUrl = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('site.name')}</title>
    <meta name="description" content={description || t('site.tagline')} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localize(locale, '')}>
          <span class="brand-name">{t('site.name')}</span>
          <span class="brand-tag">{t('site.tagline')}</span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            navItems.map((item) => {
              const url = localize(locale, item.path);
              const isActive = item.path === ''
                ? currentPath === localize(locale, '')
                : currentPath.startsWith(url);
              return (
                <a class:list={['nav-link', { active: isActive }]} href={url}>
                  {t(item.key)}
                </a>
              );
            })
          }
          <a class="lang-switch" href={otherLocaleUrl} lang={otherLocale}>
            {otherLocale === 'en' ? 'EN' : '中文'}
          </a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>{t('site.name')} · {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>
